# Rule Craft environment variables. Copy this file to .env.local and fill in
# only what you need; every variable is optional and the app runs without them.
# Never commit .env.local. On Vercel, set the same names under
# Project -> Settings -> Environment Variables, then redeploy.

# Optional, server only. Private Robinhood Chain mainnet RPC used by /api/chain, /api/pools, /api/token and /api/rpc.
# Format: full HTTPS URL, e.g. https://robinhood-mainnet.g.alchemy.com/v2/<key>
# Where: Alchemy Dashboard -> your Robinhood Chain app -> Endpoints -> HTTPS URL.
# Empty: the public RPC (rpc.mainnet.chain.robinhood.com, then publicnode) is used.
ROBINHOOD_RPC_URL=

# Optional, public (sent to the browser). Enables the WalletConnect option in the wallet dialog.
# Format: 32-character hex project id.
# Where: cloud.reown.com -> your project -> Project ID.
# Empty: WalletConnect shows "Not configured on this site yet".
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
